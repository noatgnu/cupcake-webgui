#!/usr/bin/env python3
"""
Hardware facts and report writer for the Cupcake appliance self-test.

  cupcake-selftest-report facts <output.json>
      Record the board, memory, storage, temperature, throttling, boot timing and failed units.

  cupcake-selftest-report write <state dir> <report dir> <complete|incomplete>
      Combine results.txt and the facts-*.json files in the state directory into
      cupcake-selftest-report.json and cupcake-selftest-report.txt in the report directory.

The report holds check results and hardware facts only; it never reads the appliance's .env,
so no generated secrets can end up in it.
"""

import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

THROTTLE_FLAGS = {
    0: "under-voltage now",
    1: "frequency capped now",
    2: "throttled now",
    3: "soft temperature limit now",
    16: "under-voltage has occurred",
    17: "frequency capping has occurred",
    18: "throttling has occurred",
    19: "soft temperature limit has occurred",
}
WRITE_TEST_BYTES = 64 * 1024 * 1024
WIFI_SETTINGS = {
    "802-11-wireless.ssid": "ssid",
    "802-11-wireless-security.key-mgmt": "key_management",
    "802-1x.eap": "eap_method",
    "802-1x.phase2-auth": "inner_method",
    "802-1x.system-ca-certs": "system_ca_certificates",
    "802-1x.ca-cert": "ca_certificate",
    "802-1x.domain-suffix-match": "server_domain",
}
STAGES = ("first-boot", "final")


def run(*command):
    """Return the stripped stdout of command, or None when it cannot be run or fails."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def read(path):
    """Return the stripped contents of a text file, or None when it is missing."""
    try:
        return Path(path).read_text(errors="replace").strip("\x00\n ")
    except OSError:
        return None


def os_name():
    for line in (read("/etc/os-release") or "").splitlines():
        if line.startswith("PRETTY_NAME="):
            return line.split("=", 1)[1].strip('"')
    return None


def memory_mb():
    match = re.search(r"^MemTotal:\s+(\d+) kB", read("/proc/meminfo") or "", re.MULTILINE)
    return int(match.group(1)) // 1024 if match else None


def board_revision():
    match = re.search(r"^Revision\s*:\s*(\S+)", read("/proc/cpuinfo") or "", re.MULTILINE)
    return match.group(1) if match else None


def temperature_c():
    raw = read("/sys/class/thermal/thermal_zone0/temp")
    return round(int(raw) / 1000, 1) if raw and raw.isdigit() else None


def throttling():
    raw = run("vcgencmd", "get_throttled")
    if not raw or "=" not in raw:
        return None
    value = int(raw.split("=", 1)[1], 16)
    return {
        "raw": hex(value),
        "flags": [label for bit, label in THROTTLE_FLAGS.items() if value & (1 << bit)],
    }


def storage():
    root_source = run("findmnt", "-n", "-o", "SOURCE", "/")
    facts = {"root_device": root_source}
    if not root_source:
        return facts
    disk = run("lsblk", "-n", "-o", "PKNAME", root_source)
    partition_bytes = run("lsblk", "-b", "-n", "-d", "-o", "SIZE", root_source)
    disk_bytes = run("lsblk", "-b", "-n", "-d", "-o", "SIZE", f"/dev/{disk}") if disk else None
    if partition_bytes and partition_bytes.isdigit():
        facts["root_partition_bytes"] = int(partition_bytes)
    if disk_bytes and disk_bytes.isdigit():
        facts["disk_bytes"] = int(disk_bytes)
        facts["root_filesystem_grown"] = int(partition_bytes or 0) > int(disk_bytes) * 0.9
    card = read(f"/sys/block/{disk}/device/name") if disk else None
    if card:
        facts["sd_card"] = {
            "name": card,
            "manufacturer_id": read(f"/sys/block/{disk}/device/manfid"),
            "date": read(f"/sys/block/{disk}/device/date"),
        }
    return facts


def write_speed_mb_s():
    """Write and sync 64 MiB on the root filesystem to estimate the card's sustained write speed."""
    target = Path("/var/tmp/cupcake-selftest-write-test")
    block = os.urandom(1024 * 1024)
    start = time.monotonic()
    try:
        with open(target, "wb") as handle:
            for _ in range(WRITE_TEST_BYTES // len(block)):
                handle.write(block)
            handle.flush()
            os.fsync(handle.fileno())
    except OSError:
        return None
    finally:
        target.unlink(missing_ok=True)
    return round(WRITE_TEST_BYTES / (1024 * 1024) / (time.monotonic() - start), 1)


def boot_timing():
    """Seconds from power-on to each boot stage, read from systemd while boot may still be running."""
    names = ["FirmwareTimestampMonotonic", "LoaderTimestampMonotonic", "UserspaceTimestampMonotonic"]
    raw = run("systemctl", "show", "--property=" + ",".join(names)) or ""
    values = dict(line.split("=", 1) for line in raw.splitlines() if "=" in line)
    uptime = read("/proc/uptime")
    timing = {
        "userspace_started_s": round(int(values["UserspaceTimestampMonotonic"]) / 1e6, 1)
        if values.get("UserspaceTimestampMonotonic", "0").isdigit()
        else None,
        "selftest_started_s": round(float(uptime.split()[0]), 1) if uptime else None,
    }
    firmware = values.get("FirmwareTimestampMonotonic", "0")
    loader = values.get("LoaderTimestampMonotonic", "0")
    if firmware.isdigit() and int(firmware):
        timing["firmware_s"] = round(int(firmware) / 1e6, 1)
    if loader.isdigit() and int(loader):
        timing["loader_s"] = round(int(loader) / 1e6, 1)
    return timing


def network():
    """Non-loopback addresses per interface and whether a default route exists."""
    addresses = {}
    for line in (run("ip", "-o", "addr", "show") or "").splitlines():
        parts = line.split()
        if len(parts) > 3 and parts[1] != "lo" and parts[2] in ("inet", "inet6"):
            addresses.setdefault(parts[1], []).append(parts[3])
    return {"addresses": addresses, "default_route": bool(run("ip", "route", "show", "default"))}


def wifi_settings():
    """Non-secret settings of the cupcake-wifi connection; the identity and password are left out."""
    output = run("nmcli", "-g", ",".join(WIFI_SETTINGS), "connection", "show", "cupcake-wifi")
    if output is None:
        return None
    values = output.split("\n")
    return {name: (values[i] if i < len(values) else "") for i, name in enumerate(WIFI_SETTINGS.values())}


def wifi():
    """Radio block state, connection state and the log lines that explain a Wi-Fi failure."""
    radios = []
    for radio in sorted(Path("/sys/class/rfkill").glob("rfkill*")):
        if read(radio / "type") == "wlan":
            radios.append({
                "name": read(radio / "name"),
                "soft_blocked": read(radio / "soft") == "1",
                "hard_blocked": read(radio / "hard") == "1",
            })
    devices = [
        dict(zip(("device", "type", "state", "connection"), line.split(":", 3)))
        for line in (run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device") or "").splitlines()
    ]
    first_boot = [
        line for line in (read("/var/log/cupcake/first-boot.log") or "").splitlines()
        if "wi-fi" in line.lower() or "wifi" in line.lower()
    ]
    journal = run("journalctl", "-b", "-u", "NetworkManager", "-u", "wpa_supplicant", "--no-pager",
                  "--output=cat", "--lines=400") or ""
    pattern = re.compile(r"cupcake-wifi|eap|802-1x|auth|assoc|ssid|supplicant|wlan", re.IGNORECASE)
    return {
        "radios": radios,
        "devices": devices,
        "connection_state": run("nmcli", "-g", "GENERAL.STATE", "connection", "show", "cupcake-wifi"),
        "settings": wifi_settings(),
        "first_boot_log": first_boot[-10:],
        "network_manager_log": [line for line in journal.splitlines() if pattern.search(line)][-30:],
    }


def tailscale():
    """Whether the device joined a tailnet, its name and addresses there, and the first-boot log lines."""
    raw = run("tailscale", "status", "--json")
    if raw is None:
        return None
    try:
        status = json.loads(raw)
    except json.JSONDecodeError:
        return None
    node = status.get("Self") or {}
    return {
        "state": status.get("BackendState"),
        "hostname": node.get("HostName"),
        "dns_name": (node.get("DNSName") or "").rstrip(".") or None,
        "addresses": status.get("TailscaleIPs") or node.get("TailscaleIPs") or [],
        "online": node.get("Online"),
        "tailnet": (status.get("CurrentTailnet") or {}).get("Name"),
        "health": status.get("Health") or [],
        "first_boot_log": [
            line for line in (read("/var/log/cupcake/first-boot.log") or "").splitlines()
            if "tailscale" in line.lower()
        ][-10:],
    }


def failed_units():
    output = run("systemctl", "--failed", "--no-legend", "--plain") or ""
    units = []
    for line in output.splitlines():
        unit = line.split()[0] if line.split() else ""
        if unit:
            journal = run("journalctl", "-b", "-u", unit, "--no-pager", "--lines=20", "--output=cat") or ""
            units.append({"unit": unit, "journal": journal.splitlines()})
    return units


def facts():
    return {
        "recorded_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "board": {
            "model": read("/proc/device-tree/model"),
            "revision": board_revision(),
            "memory_mb": memory_mb(),
        },
        "software": {
            "os": os_name(),
            "kernel": run("uname", "-r"),
            "bootloader": run("vcgencmd", "bootloader_version"),
            "appliance_versions": read("/opt/cupcake/versions.txt"),
        },
        "temperature_c": temperature_c(),
        "throttling": throttling(),
        "storage": storage(),
        "network": network(),
        "wifi": wifi(),
        "tailscale": tailscale(),
        "write_speed_mb_s": write_speed_mb_s(),
        "boot": {
            "timing": boot_timing(),
            "slowest_units": (run("systemd-analyze", "blame", "--no-pager") or "").splitlines()[:10],
        },
        "failed_units": failed_units(),
    }


def parse_results(path):
    """Read "## section" headers with "PASS: name" / "FAIL: name" lines, "NOTE: text" lines and
    "METRIC: name=value" lines."""
    sections = []
    notes = []
    metrics = {}
    for line in (read(path) or "").splitlines():
        if line.startswith("## "):
            sections.append({"name": line[3:], "checks": []})
        elif line.startswith("NOTE: "):
            notes.append(line[6:])
        elif line.startswith("METRIC: ") and "=" in line:
            name, value = line[8:].split("=", 1)
            metrics[name.strip()] = value.strip()
        elif sections and line.startswith(("PASS: ", "FAIL: ")):
            sections[-1]["checks"].append({"name": line[6:], "passed": line.startswith("PASS")})
    return sections, notes, metrics


def summary(report):
    lines = [
        f"Cupcake self-test: {report['result'].upper()}",
        f"Written: {report['written_at']}",
        "",
    ]
    if report["result"] != "incomplete":
        lines.append("This device ran tests that leave data behind; reflash it before real use.")
        lines.append("")
    lines.extend(f"Note: {note}" for note in report["notes"])
    if report["notes"]:
        lines.append("")
    lines.extend(f"Metric: {name} = {value}" for name, value in report.get("metrics", {}).items())
    if report.get("metrics"):
        lines.append("")
    for section in report["sections"]:
        passed = sum(check["passed"] for check in section["checks"])
        lines.append(f"{section['name']}: {passed}/{len(section['checks'])} passed")
        lines.extend(f"  FAIL: {check['name']}" for check in section["checks"] if not check["passed"])
    for stage, stage_facts in report["hardware"].items():
        board = stage_facts["board"]
        throttle = stage_facts.get("throttling") or {}
        timing = stage_facts.get("boot", {}).get("timing") or {}
        lines += [
            "",
            f"[{stage}] {board.get('model')} rev {board.get('revision')}, {board.get('memory_mb')} MB RAM",
            f"  temperature {stage_facts.get('temperature_c')} C, write speed {stage_facts.get('write_speed_mb_s')} MB/s",
            f"  throttling: {', '.join(throttle.get('flags') or ['none']) if throttle else 'unknown'}",
            f"  root filesystem grown: {stage_facts['storage'].get('root_filesystem_grown')}",
            f"  boot: userspace after {timing.get('userspace_started_s')} s, "
            f"self-test started {timing.get('selftest_started_s')} s after power-on",
        ]
        wifi_facts = stage_facts.get("wifi") or {}
        for radio in wifi_facts.get("radios", []):
            blocked = "soft-blocked" if radio["soft_blocked"] else "hard-blocked" if radio["hard_blocked"] else "unblocked"
            lines.append(f"  wi-fi radio {radio['name']}: {blocked}")
        for device in wifi_facts.get("devices", []):
            if device.get("type") in ("wifi", "ethernet"):
                lines.append(f"  {device['device']} ({device['type']}): {device.get('state')} {device.get('connection') or ''}".rstrip())
        settings = wifi_facts.get("settings") or {}
        if settings:
            if settings.get("system_ca_certificates") == "yes":
                server_check = "system certificates"
            elif settings.get("ca_certificate"):
                server_check = "CA file"
            else:
                server_check = "certificate not checked"
            if settings.get("server_domain"):
                server_check += f", server domain {settings['server_domain']}"
            method = "/".join(v for v in (settings.get("eap_method"), settings.get("inner_method")) if v)
            lines.append(
                f"  wi-fi settings: {settings.get('ssid')}, {settings.get('key_management')}"
                + (f" {method}" if method else "")
                + (f", {server_check}" if settings.get("key_management") == "wpa-eap" else "")
            )
        lines.extend(f"  first-boot: {line}" for line in wifi_facts.get("first_boot_log", []))
        tailscale_facts = stage_facts.get("tailscale")
        if tailscale_facts:
            joined = tailscale_facts.get("state") == "Running"
            lines.append(
                f"  tailscale: {tailscale_facts.get('state')}"
                + (f" as {tailscale_facts.get('dns_name') or tailscale_facts.get('hostname')}"
                   f" {', '.join(tailscale_facts.get('addresses') or [])}" if joined else "")
            )
            lines.extend(f"  tailscale health: {issue}" for issue in tailscale_facts.get("health", []))
            lines.extend(f"  first-boot: {line}" for line in tailscale_facts.get("first_boot_log", []))
        lines.extend(f"  failed unit: {unit['unit']}" for unit in stage_facts.get("failed_units", []))
    return "\n".join(lines) + "\n"


def write(state_dir, report_dir, completion):
    state_dir = Path(state_dir)
    sections, notes, metrics = parse_results(state_dir / "results.txt")
    all_passed = all(check["passed"] for section in sections for check in section["checks"])
    report = {
        "format_version": 1,
        "written_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "result": "incomplete" if completion != "complete" else ("pass" if all_passed else "fail"),
        "sections": sections,
        "notes": notes,
        "metrics": metrics,
        "hardware": {
            stage: json.loads((state_dir / f"facts-{stage}.json").read_text())
            for stage in STAGES
            if (state_dir / f"facts-{stage}.json").exists()
        },
    }
    report_dir = Path(report_dir)
    (report_dir / "cupcake-selftest-report.json").write_text(json.dumps(report, indent=2) + "\n")
    (report_dir / "cupcake-selftest-report.txt").write_text(summary(report))
    os.sync()
    print(report["result"])


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "facts":
        Path(sys.argv[2]).write_text(json.dumps(facts(), indent=2) + "\n")
        return 0
    if len(sys.argv) == 5 and sys.argv[1] == "write":
        write(sys.argv[2], sys.argv[3], sys.argv[4])
        return 0
    print(__doc__, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
