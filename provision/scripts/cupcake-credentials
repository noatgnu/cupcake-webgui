#!/bin/bash
# Gives each appliance its own passwords the first time it boots as a new machine (a new
# /etc/machine-id), replacing the admin / cupcake and cupcake / cupcake defaults that every image
# ships with.
#
#   - web admin user "admin": random password, kept root-only in /opt/cupcake/.admin-password for
#     on-device tools such as the self-test
#   - operating-system user "cupcake": random password
#
# Both are written to cupcake-credentials.txt in each directory given on the command line (the
# Raspberry Pi boot partition, or the x86 EFI partition and config stick), readable from any
# computer, and shown on the console login screen. Passwords are never written to a log.
#
# Usage: cupcake-credentials <directory>...
set -euo pipefail

CUPCAKE_DIR=/opt/cupcake
MARKER="$CUPCAKE_DIR/.credentials-machine-id"
ADMIN_PASSWORD_FILE="$CUPCAKE_DIR/.admin-password"
CONSOLE_NOTICE=/etc/issue.d/cupcake-credentials.issue

MACHINE_ID=$(cat /etc/machine-id 2>/dev/null || true)
if [ -z "$MACHINE_ID" ] || [ "$(cat "$MARKER" 2>/dev/null || true)" = "$MACHINE_ID" ]; then
    exit 0
fi

new_password() {
    tr -dc 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789' < /dev/urandom | head -c 16 || true
}

set -a
source "$CUPCAKE_DIR/.env"
set +a

for _ in $(seq 1 90); do
    pg_isready -q -h "${POSTGRES_HOST:-localhost}" -p "${POSTGRES_PORT:-5432}" && break
    sleep 2
done

ADMIN_PASSWORD=$(new_password)
USER_PASSWORD=$(new_password)

(cd "$CUPCAKE_DIR/backend" && CUPCAKE_ADMIN_PASSWORD="$ADMIN_PASSWORD" \
    runuser -u cupcake-svc -- "$CUPCAKE_DIR/venv/bin/python" manage.py shell -c "
import os
from django.contrib.auth import get_user_model
user = get_user_model().objects.get(username='admin')
user.set_password(os.environ['CUPCAKE_ADMIN_PASSWORD'])
user.save(update_fields=['password'])
" >/dev/null)
echo "cupcake:$USER_PASSWORD" | chpasswd

install -m 600 /dev/null "$ADMIN_PASSWORD_FILE"
printf '%s\n' "$ADMIN_PASSWORD" > "$ADMIN_PASSWORD_FILE"

CREDENTIALS="Cupcake appliance passwords for $(hostname)

Web apps (Cupcake and Cupcake Vanilla)
  username: admin
  password: $ADMIN_PASSWORD

Operating system (SSH, keyboard and screen)
  username: cupcake
  password: $USER_PASSWORD

Change both after signing in, then delete this file. The web admin password can
also be changed from the command line:
  cd /opt/cupcake/backend && sudo -u cupcake-svc bash -c 'set -a; source /opt/cupcake/.env; set +a; /opt/cupcake/venv/bin/python manage.py changepassword admin'
"

install -m 600 /dev/null /root/cupcake-credentials.txt
printf '%s' "$CREDENTIALS" > /root/cupcake-credentials.txt
for dir in "$@"; do
    if [ -d "$dir" ] && printf '%s' "$CREDENTIALS" > "$dir/cupcake-credentials.txt" 2>/dev/null; then
        echo "Passwords for this appliance written to $dir/cupcake-credentials.txt"
    fi
done

mkdir -p "$(dirname "$CONSOLE_NOTICE")"
printf 'Cupcake: web admin password %s, user cupcake password %s (also in /root/cupcake-credentials.txt)\n\n' \
    "$ADMIN_PASSWORD" "$USER_PASSWORD" > "$CONSOLE_NOTICE"
chmod 644 "$CONSOLE_NOTICE"

printf '%s\n' "$MACHINE_ID" > "$MARKER"
chmod 600 "$MARKER"
echo "Generated passwords for this appliance"
