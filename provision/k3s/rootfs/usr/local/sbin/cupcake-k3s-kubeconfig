#!/bin/bash
# Gives the Pi's first user a kubeconfig for the control plane.
set -euo pipefail

SOURCE=/etc/rancher/k3s/k3s.yaml
for _ in $(seq 1 60); do
  [ -s "$SOURCE" ] && break
  sleep 2
done
[ -s "$SOURCE" ] || exit 0

USER_LINE=$(getent passwd 1000 || true)
[ -n "$USER_LINE" ] || exit 0
OWNER=$(cut -d: -f1 <<< "$USER_LINE")
HOME_DIR=$(cut -d: -f6 <<< "$USER_LINE")

install -d -m 700 -o "$OWNER" -g "$OWNER" "$HOME_DIR/.kube"
sed "s#https://127.0.0.1:6443#https://$(hostname).local:6443#" "$SOURCE" > "$HOME_DIR/.kube/config.new"
chown "$OWNER:$OWNER" "$HOME_DIR/.kube/config.new"
chmod 600 "$HOME_DIR/.kube/config.new"
mv -f "$HOME_DIR/.kube/config.new" "$HOME_DIR/.kube/config"
