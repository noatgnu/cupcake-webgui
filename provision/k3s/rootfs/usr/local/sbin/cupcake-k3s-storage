#!/bin/bash
# Puts /var/lib/rancher (k3s, its images and the volumes it provides) on the USB drive named in cupcake-storage.txt.
# With FORMAT=yes, a USB drive that is not ext4, xfs or btrfs is formatted as ext4 first, erasing it.
set -euo pipefail

CONFIG="${CUPCAKE_K3S_STORAGE_CONFIG:-/boot/firmware/cupcake-storage.txt}"
ERROR_FILE="$(dirname "$CONFIG")/cupcake-k3s-error.txt"
DATA=/srv/cupcake-data
RANCHER=/var/lib/rancher
WARNING_FILE=/var/lib/cupcake-k3s/storage-warning

log() { echo "cupcake-k3s: $*"; }
fail() {
  log "$*"
  printf '%s\nFix cupcake-storage.txt and restart the Pi.\n' "$*" > "$ERROR_FILE" || true
  exit 1
}

value() {
  local line
  line=$(tr -d '\r' < "$CONFIG" | grep -E "^[[:space:]]*$1[[:space:]]*=" | tail -1 || true)
  line="${line#*=}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

[ -f "$CONFIG" ] || exit 0
if mountpoint -q "$RANCHER"; then
  log "$RANCHER is already on the USB drive"
  exit 0
fi
if [ -e /var/lib/cupcake-k3s/configured ]; then
  fail "Storage can only be chosen before the Pi is first configured; flash the card again to use a USB drive"
fi

TYPE=$(value TYPE)
LABEL=$(value LABEL)
LABEL="${LABEL:-CUPCAKEDATA}"
[ "${TYPE:-usb}" = usb ] || fail "k3s nodes keep their data on a USB drive only (TYPE=usb), not ${TYPE}"

DEVICE=""
for _ in $(seq 1 30); do
  DEVICE=$(blkid -L "$LABEL" 2>/dev/null || true)
  [ -n "$DEVICE" ] && break
  sleep 2
done
[ -n "$DEVICE" ] || fail "No drive labelled $LABEL is plugged in"

DISK=$(lsblk -no PKNAME "$DEVICE" 2>/dev/null | head -1)
install -d -m 755 "$(dirname "$WARNING_FILE")"
rm -f "$WARNING_FILE"
if [ "$(cat "/sys/block/${DISK:-none}/removable" 2>/dev/null)" = 1 ]; then
  if [ "$(value ALLOW_FLASH | tr '[:upper:]' '[:lower:]')" != yes ]; then
    fail "The drive labelled $LABEL looks like a USB flash stick, which writes k3s's and the instances' databases too slowly. Use a USB SSD, or remove cupcake-storage.txt to use the SD card, or add ALLOW_FLASH=yes to cupcake-storage.txt to use the stick anyway"
  fi
  log "using the drive labelled $LABEL although it looks like a USB flash stick"
  echo "The drive labelled $LABEL looks like a USB flash stick, which writes k3s's and the instances' databases slowly; use a USB SSD instead" > "$WARNING_FILE"
fi

FSTYPE=$(blkid -o value -s TYPE "$DEVICE")
case "$FSTYPE" in
  ext4|xfs|btrfs) ;;
  *)
    if [ "$(value FORMAT | tr '[:upper:]' '[:lower:]')" != yes ]; then
      fail "The drive labelled $LABEL is $FSTYPE; k3s needs ext4. Add FORMAT=yes to cupcake-storage.txt to have it formatted, erasing it, or run: sudo mkfs.ext4 -L $LABEL $DEVICE"
    fi
    [ "$(lsblk -dno TRAN "/dev/${DISK:-none}" 2>/dev/null)" = usb ] \
      || fail "The drive labelled $LABEL is not on USB, so it is not formatted"
    ROOT_DISK=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null | head -1)
    [ "$DISK" != "$ROOT_DISK" ] || fail "The drive labelled $LABEL holds the running system, so it is not formatted"
    ! findmnt -rno TARGET -S "$DEVICE" >/dev/null || fail "The drive labelled $LABEL is in use, so it is not formatted"
    log "formatting $DEVICE ($LABEL, $FSTYPE) as ext4"
    wipefs -a "$DEVICE" >/dev/null
    mkfs.ext4 -q -F -L "$LABEL" "$DEVICE" || fail "Formatting the drive labelled $LABEL failed"
    udevadm settle 2>/dev/null || true
    FSTYPE=ext4
    ;;
esac
UUID=$(blkid -p -o value -s UUID "$DEVICE")

install -d -m 755 "$DATA"
grep -q " $DATA " /etc/fstab 2>/dev/null || \
  printf 'UUID=%s %s %s defaults,noatime,nofail,x-systemd.device-timeout=30s 0 2\n' "$UUID" "$DATA" "$FSTYPE" >> /etc/fstab
mount "$DATA"

install -d -m 755 "$DATA/rancher"
if [ -z "$(ls -A "$DATA/rancher")" ] && [ -d "$RANCHER" ]; then
  cp -a "$RANCHER/." "$DATA/rancher/"
fi
install -d -m 755 "$RANCHER"
grep -q " $RANCHER " /etc/fstab || \
  printf '%s %s none bind,x-systemd.requires-mounts-for=%s 0 0\n' "$DATA/rancher" "$RANCHER" "$DATA" >> /etc/fstab
systemctl daemon-reload
mount "$RANCHER"

printf '# %s (%s) holds this Pi'"'"'s k3s data at %s.\n' "$LABEL" "$DEVICE" "$RANCHER" > "$CONFIG"
rm -f "$ERROR_FILE"
log "k3s data is on $DEVICE ($LABEL, $FSTYPE)"
