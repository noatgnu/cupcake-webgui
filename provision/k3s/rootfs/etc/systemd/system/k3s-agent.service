[Unit]
Description=Cupcake k3s worker
Documentation=https://docs.k3s.io
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target cupcake-k3s-setup.service
ConditionPathExists=/etc/rancher/k3s/config.yaml
RequiresMountsFor=/var/lib/rancher

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
NotifyAccess=all
EnvironmentFile=-/etc/default/k3s-agent
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/sbin/cupcake-k3s-agent

