{
  "name": "cupcake",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron:dev:server": "cd electron-app && npm run dev:server",
    "electron:dev:built": "ng build --configuration=electron && cd electron-app && npm run dev:built",
    "electron:build": "cd electron-app && npm run build",
    "electron:build:win": "cd electron-app && npm run build:win",
    "electron:build:mac": "cd electron-app && npm run build:mac",
    "electron:build:linux": "cd electron-app && npm run build:linux",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.8",
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@ericblade/quagga2": "^1.8.4",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@noatgnu/cupcake-core": "^1.4.1",
    "@noatgnu/cupcake-macaron": "^1.4.0",
    "@noatgnu/cupcake-mint-chocolate": "^1.3.0",
    "@noatgnu/cupcake-red-velvet": "^1.4.0",
    "@noatgnu/cupcake-salted-caramel": "^1.3.0",
    "@noatgnu/cupcake-vanilla": "^1.4.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.13.1",
    "jssha": "^3.3.1",
    "ngx-quill": "^31.0.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@playwright/test": "^1.44.0",
    "@types/jasmine": "~5.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer": "^24.39.1",
    "typescript": "~6.0.3",
    "wait-on": "^8.0.3"
  }
}