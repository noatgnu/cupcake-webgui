{
  "name": "cupcake-wails-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:integration:headed": "playwright test --config=playwright.integration.config.ts --headed",
    "test:setup-flows": "playwright test --config=playwright.setup-flows.config.ts",
    "test:setup-flows:headed": "playwright test --config=playwright.setup-flows.config.ts --headed",
    "test:wails-ui": "playwright test --config=playwright.ui.config.ts --project=workflows",
    "test:wails-ui-native": "playwright test --config=playwright.ui.config.ts --project=native-setup",
    "test:wails-ui-workflows": "playwright test --config=playwright.ui.config.ts --project=workflows --no-deps",
    "test:screens": "playwright test --config=playwright.screens.config.ts",
    "test:wails-ui-sign-in": "playwright test --config=playwright.ui.config.ts --project=desktop-sign-in",
    "test:all": "npm run test:e2e && npm run test:integration && npm run test:setup-flows && npm run test:screens"
  },
  "dependencies": {
    "@angular/animations": "22.3.0",
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@noatgnu/cupcake-core": "^1.4.17",
    "@popperjs/core": "^2.11.8",
    "@wailsio/runtime": "3.1.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/localize": "22.3.0",
    "@playwright/test": "^1.65.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~6.0.3"
  }
}
